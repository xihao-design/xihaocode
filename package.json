{
  "name": "xihaoz-site",
  "version": "2.1.0",
  "private": true,
  "description": "西浩资源库 —— 精选开源资源站（开源软件 / 技能 / MCP）。纯静态生成，零第三方依赖。",
  "scripts": {
    "build": "node redesign/build.mjs",
    "check": "node redesign/tools/check-dist.js && node redesign/tools/check-facets.mjs",
    "margins": "node redesign/tools/check-margins.mjs",
    "sections": "node redesign/tools/check-sections.mjs",
    "facets:check": "node redesign/tools/check-facets.mjs",
    "smoke": "node redesign/tools/smoke.mjs",
    "urls": "node redesign/tools/check-urls.mjs",
    "shots": "node redesign/tools/shots.mjs",
    "og": "node redesign/tools/make-og.mjs",
    "token": "node redesign/tools/check-token.mjs",
    "topics": "node redesign/tools/probe-topics.mjs",
    "skills:discover": "node redesign/tools/skills/discover.mjs",
    "skills:pack": "node redesign/tools/skills/pack.mjs",
    "skills:entries": "node redesign/tools/skills/entries.mjs",
    "ai:import": "node redesign/tools/ai-tools/import.mjs",
    "ai:check": "node redesign/tools/ai-tools/import.mjs --dry",
    "icons": "node redesign/tools/fetch-icons.mjs",
    "verify": "node redesign/tools/verify-repos.mjs",
    "extract": "powershell -NoProfile -ExecutionPolicy Bypass -File redesign/tools/extract-kb.ps1",
    "daily": "node redesign/tools/daily/collect.mjs",
    "daily:links": "node redesign/tools/daily/apply-links.mjs",
    "daily:publish": "node redesign/tools/daily/publish.mjs",
    "daily:verify": "node redesign/tools/daily/verify-live.mjs",
    "daily:selftest": "node redesign/tools/daily/selftest.mjs",
    "daily:merge": "node redesign/tools/daily/merge.mjs",
    "daily:task": "powershell -NoProfile -ExecutionPolicy Bypass -File redesign/tools/daily/install-task.ps1",
    "skills:links": "node redesign/tools/skills/links.mjs",
    "baidu:push": "node redesign/tools/baidu-push.mjs",
    "index:check": "node redesign/tools/check-index.mjs",
    "index:quota": "node redesign/tools/check-quota.mjs",
    "sitemap:submit": "node redesign/tools/submit-sitemap.mjs",
    "skills:check-links": "node redesign/tools/skills/check-links.mjs",
    "desktop:discover": "node redesign/tools/desktop/discover.mjs",
    "desktop:test": "node redesign/tools/desktop/test-pick.mjs && node redesign/tools/desktop/test-app-check.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
